{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ich",
	"compatibility_date": "2026-09-01",
	// Static assets only — no Worker script, no server runtime.
	"assets": {
		"directory": "./build",
		// /arbeit -> arbeit.html, /fotografie/hamburg -> fotografie/hamburg.html
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
